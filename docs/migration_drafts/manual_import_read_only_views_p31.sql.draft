-- ---------------------------------------------------------------------------
-- Draft view: public.manual_import_competitions_lookup
-- ---------------------------------------------------------------------------
-- Purpose: allow read-only lookup of competition identifiers and public fields
-- needed by manual/mock import planning.
-- Source table/columns confirmed locally from supabase/migrations/0001_base_schema.sql.
-- Public view shape confirmed locally from supabase/migrations/0004_public_views.sql.

create or replace view public.manual_import_competitions_lookup
with (security_barrier = true)
as
select
  competition.id,
  competition.internal_key,
  competition.api_competition_id,
  competition.slug,
  competition.name,
  competition.country,
  competition.continent,
  competition.season,
  competition.tracking_level,
  competition.status,
  competition.visibility,
  competition.public_stats_enabled,
  competition.login_required_for_full_stats,
  competition.created_at,
  competition.updated_at
from public.competitions competition;

comment on view public.manual_import_competitions_lookup is
  'MIGRATION_DRAFT_ONLY P31: read-only lookup proposal for manual import competitions. DO NOT APPLY without review.';

-- REVIEW_REQUIRED: grants are intentionally not included in this draft.
-- REVIEW_REQUIRED: evaluate SELECT scope for anon/authenticated/admin/editor.
-- REVIEW_REQUIRED: evaluate whether filtering by is_editor_or_admin() is needed.

-- ---------------------------------------------------------------------------
-- Draft view: public.manual_import_teams_lookup
-- ---------------------------------------------------------------------------
-- Purpose: allow read-only lookup of team identifiers and competition relation
-- needed by manual/mock import planning.
-- Source table/columns confirmed locally from supabase/migrations/0001_base_schema.sql.

create or replace view public.manual_import_teams_lookup
with (security_barrier = true)
as
select
  team.id,
  team.competition_id,
  team.source_provider_id,
  team.api_team_id,
  team.slug,
  team.name,
  team.short_name,
  team.country,
  team.city,
  team.status,
  team.visibility,
  team.created_at,
  team.updated_at
from public.teams team;

comment on view public.manual_import_teams_lookup is
  'MIGRATION_DRAFT_ONLY P31: read-only lookup proposal for manual import teams. DO NOT APPLY without review.';

