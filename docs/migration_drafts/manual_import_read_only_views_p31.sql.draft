-- ---------------------------------------------------------------------------
-- Draft view: public.manual_import_standings_lookup
-- ---------------------------------------------------------------------------
-- Purpose: allow read-only lookup of standings identifiers and metrics needed
-- by manual/mock import planning.
-- Source table/columns confirmed locally from supabase/migrations/0001_base_schema.sql.

create or replace view public.manual_import_standings_lookup
with (security_barrier = true)
as
select
  standing.id,
  standing.competition_id,
  standing.team_id,
  standing.source_provider_id,
  standing.season,
  standing.stage,
  standing.matchday,
  standing.rank,
  standing.played,
  standing.won,
  standing.drawn,
  standing.lost,
  standing.goals_for,
  standing.goals_against,
  standing.goal_difference,
  standing.points,
  standing.form,
  standing.qualification_note,
  standing.status,
  standing.visibility,
  standing.created_at,
  standing.updated_at
from public.standings standing;

comment on view public.manual_import_standings_lookup is
  'MIGRATION_DRAFT_ONLY P31: read-only lookup proposal for manual import standings. DO NOT APPLY without review.';

